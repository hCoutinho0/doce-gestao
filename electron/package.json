{
  "name": "confeitto",
  "productName": "Confeitto",
  "version": "3.0.0",
  "description": "Confeitto - Gestão que adoça seu negócio",
  "author": "Confeitto",
  "main": "bootstrap.cjs",
  "private": true,
  "build": {
    "appId": "br.com.confeitto.app",
    "productName": "Confeitto",
    "copyright": "Confeitto",
    "files": [
      "bootstrap.cjs",
      "app/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.ico",
      "artifactName": "Confeitto-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Confeitto",
      "uninstallDisplayName": "Confeitto",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "../build/icon.ico",
      "uninstallerIcon": "../build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "directories": {
      "output": "../instalador",
      "buildResources": "../build"
    },
    "electronVersion": "39.8.10"
  }
}
